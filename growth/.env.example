# Growth API — copy to growth/.env (gitignored). Never commit real secrets.

GROWTH_INTERNAL_SECRET=change-me-use-op-or-strong-random
GROWTH_ENABLED=true
PORT=4210
GROWTH_API_BASE=http://127.0.0.1:4210
REVENUE_AGENTS_ROOT=/home/anthony/Klaravex2.0/revenue-agents
# Optional: persist ledger to growth/data/runs.jsonl
GROWTH_PERSIST_RUNS=true

# Charter executor (Layer A → Claude session)
GROWTH_EXECUTOR_ENABLED=true
GROWTH_EXECUTOR_DRY_RUN=false
GROWTH_CLAUDE_BIN=claude
GROWTH_KLARAVEX_ROOT=/home/anthony/klaravex
GROWTH_EXECUTOR_TIMEOUT_S=7200
# GROWTH_EXECUTOR_MODEL=sonnet
GROWTH_EXECUTOR_BYPASS_PERMISSIONS=true

# Leads research pre-enrichment (11-scraper pipeline; reads API keys from GROWTH_KLARAVEX_ROOT/.env)
GROWTH_RESEARCH_ENABLED=true
GROWTH_RESEARCH_MIN_CONFIDENCE=0.30
GROWTH_RESEARCH_MAX_PROSPECTS=100
GROWTH_RESEARCH_CONCURRENCY=8
GROWTH_RESEARCH_TIMEOUT_S=3600

# Phase 5 — adapter credential source (read-only probes; never commit secrets here)
# GROWTH_ADAPTER_ENV_FILE=/home/anthony/klaravex/infra/docker-services/worker/.env

# POC sandbox — fixture data instead of Apollo/scrapers/adapters (no live I/O)
GROWTH_POC_MODE=false
# GROWTH_POC_FIXTURES_DIR=/home/anthony/Klaravex2.0/growth/data/poc

# Phase 5 — adapter readonly defaults (set false for live enqueue/publish)
# SMARTLEAD_READONLY=false
# WORDPRESS_READONLY=false
# GROWTH_DISPATCH_ON_GATE=true
# WORDPRESS_AUTO_PUBLISH=true  # APPROVED seo-blog/kb drafts publish live instead of WP draft
# Reddit auto-posting (forums stream) — script app on the KlaravexAi account
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=KlaravexAi
# REDDIT_PASSWORD=
# REDDIT_READONLY=true   # set false to post live (5/day cap, 10-min spacing)
