# =============================================================================
# /etc/loki-watchdog.env  —  copy per host, then: chmod 600 /etc/loki-watchdog.env
# These values override the defaults baked into loki-watchdog.sh.
# =============================================================================

# ---------------------------------------------------------------------------
# HOST A — Cloud86 (the SecondBrain stack: postgres + ollama + vault-mcp)
# ---------------------------------------------------------------------------
HOST_LABEL=cloud86
COMPOSE_DIR=$HOME/loki-vault

WATCH_POSTGRES=true
WATCH_OLLAMA=true
WATCH_MCP=true
WATCH_QUEUE=true

PG_CONTAINER=loki-postgres
OLLAMA_CONTAINER=loki-ollama
MCP_CONTAINER=loki-vault-mcp
MCP_SERVICE=vault-mcp
MCP_LABEL=mcp

HEALTH_URL=http://127.0.0.1:3141/health
# Must match MCP_API_KEY in $COMPOSE_DIR/.env if auth is enabled, else blank.
MCP_API_KEY=
OLLAMA_MODEL=nomic-embed-text
PG_DB=loki_vault
PG_USER=postgres

# Oldest 'pending' note older than this (seconds) = embedding worker stalled.
# Worker loops every 10s, so 600s is a very conservative "definitely stuck".
QUEUE_STALL_SECONDS=600

# Slack incoming-webhook / Discord webhook / generic. Blank = log to journal only.
WEBHOOK_URL=
# healthchecks.io (or compatible) ping URL. Pings on success; appends /fail on error.
# Free: https://healthchecks.io → New Check → period 30m, grace 5m → copy ping URL here.
HEALTHCHECK_URL=

# ---------------------------------------------------------------------------
# HOST B — Hetzner Loki backend (CX22, 178.105.84.32)
# Loki app talks to the SHARED Cloud86 Postgres, so there is NO local pg/ollama
# to heal here. Watch only the Loki app container + its /health endpoint.
# Copy this block to Hetzner's /etc/loki-watchdog.env and DELETE Host A's block.
# ---------------------------------------------------------------------------
# HOST_LABEL=hetzner-loki
# COMPOSE_DIR=/opt/loki                       # adjust to the real compose dir
# COMPOSE_FILE=/opt/loki/docker-compose.klaravex.yml   # if non-default name
# WATCH_POSTGRES=false
# WATCH_OLLAMA=false
# WATCH_QUEUE=false
# WATCH_MCP=true
# MCP_CONTAINER=loki-app                      # adjust to the real container name
# MCP_SERVICE=loki                            # adjust to the real compose service
# MCP_LABEL=loki
# HEALTH_URL=http://127.0.0.1:8080/health     # adjust to Loki's real health port/path
# MCP_API_KEY=
# WEBHOOK_URL=                                # same webhook as Cloud86
