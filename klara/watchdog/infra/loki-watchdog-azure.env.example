# =============================================================================
# /etc/loki-watchdog-azure.env — config for loki-watchdog-azure.sh
# Install:
#   sudo cp loki-watchdog-azure.env.example /etc/loki-watchdog-azure.env
#   sudo nano /etc/loki-watchdog-azure.env        # fill in secrets + Anthony's mobile route
#   sudo chmod 600 /etc/loki-watchdog-azure.env   # contains secrets
# =============================================================================

# ---- Probe target -----------------------------------------------------------
KLARAVEX_API=https://api.klaravex.com
# KLARAVEX_API_HEALTH defaults to ${KLARAVEX_API}/health
# KLARAVEX_API_OPENAPI defaults to ${KLARAVEX_API}/openapi.json

# Hostname label used in logs + escalation payloads.
HOST_LABEL=us-watchdog

# ---- Azure self-heal (revision restart) -------------------------------------
# Only used if `az` CLI is installed and authenticated (managed identity on
# an Azure VM, or `az login` on Hetzner/Cowork). Leave AZURE_RG/APP blank to
# disable the self-heal leg and rely on escalation only.
AZURE_RG=klaravex-prod
AZURE_APP=klaravex-api

# ---- Flap thresholds --------------------------------------------------------
# Restart revision after this many failed probes within the window.
HEAL_AFTER_FAILS=2
FLAP_WINDOW_SECONDS=1800
# Stop healing after this many heals — escalate instead.
MAX_HEALS_PER_WINDOW=3

# ---- Escalation (T-INF-11) --------------------------------------------------
# Two independent paths; first 2xx response wins. Order is honoured.
#   vapi     → POST /api/v1/vapi/escalate_to_anthony   header x-watchdog-secret
#   internal → POST /api/v1/escalate                    header x-loki-internal-secret
#
# KNOWN LIMITATION (2026-06-30 deploy verified): the `internal` endpoint
# returns 500 for watchdog-shaped escalations because its server lib casts
# ticket_id to UUID and does a DB status update on a row that does not
# exist (synthesised UUIDs from the watchdog have no matching ticket).
# Recommendation: leave ESCALATE_PATHS=vapi until the endpoint grows a
# system-escalation mode that accepts unknown ticket_id. Tracked as the
# T-INF-11 follow-up task.
ESCALATE_PATHS=vapi
VAPI_ESCALATE_URL=https://api.klaravex.com/api/v1/vapi/escalate_to_anthony
ESCALATE_URL=https://api.klaravex.com/api/v1/escalate

# Secrets (REQUIRED for the corresponding path to be attempted).
# WATCHDOG_ESCALATION_SECRET → primary path (Vapi). MUST match the value
# already set on klaravex-api Azure Container App (revision 0000122 has it).
# Look up in 1Password Klaravex vault, NOT in this file's commit history.
WATCHDOG_ESCALATION_SECRET=

# LOKI_INTERNAL_SECRET → secondary path (ticket-shaped /api/v1/escalate).
# Also lives in 1Password Klaravex vault. May be unset if you want vapi-only.
LOKI_INTERNAL_SECRET=

# After paging Anthony, don't page again for this many seconds (avoid
# every-cycle paging during sustained outage).
ESCALATE_COOLDOWN_SECONDS=1800

# System "from" email for the /api/v1/escalate (internal) path. Endpoint
# requires a valid EmailStr in client_email; watchdog has no real client.
ESCALATE_SYSTEM_EMAIL=watchdog@klaravex.com

# ---- External dead-man's-switch (optional) ----------------------------------
# Healthchecks.io ping URL. Empty = no external ping (the watchdog still
# escalates on outage, but a fully dead watchdog won't be detected).
# Recommend: free healthchecks.io check with period=5m, grace=2m.
HEALTHCHECK_URL=

# ---- Curl/az timeouts -------------------------------------------------------
CURL_TIMEOUT=10
AZ_TIMEOUT=60

# ---- State / status JSON ----------------------------------------------------
STATE_DIR=/var/lib/loki-watchdog-azure
# Optional: writes a JSON heartbeat for an external monitor.
# STATUS_JSON=/var/lib/loki-watchdog-azure/watchdog-status.json
