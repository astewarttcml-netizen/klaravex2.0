[Unit]
Description=Rara RARV heartbeat — 4-agent journal pipeline (Klaravex2.0)
Documentation=https://github.com/astewarttcml-netizen/klaravex-vault
After=network-online.target klaravex-db-tunnel.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/anthony/Klaravex2.0
EnvironmentFile=/home/anthony/Klaravex2.0/klara/rarv/.env.rarv
ExecStart=/usr/bin/python3 /home/anthony/Klaravex2.0/klara/rarv/run_heartbeat.py
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

# Hardening
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
