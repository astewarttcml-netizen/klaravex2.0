# ============================================================
# .env.example — Klara AI Vault MCP Server
# Copy to .env and replace all CHANGE_ME values.
# NEVER commit .env to git.
# ============================================================

# --- PostgreSQL (US Azure klaravex-db-r2 via klaravex-db-tunnel.service) ---
# Tunnel: 127.0.0.1:15432 (host) / host.docker.internal:15432 (container).
# Schema `vault` owns vault_embeddings / note_submissions / memory_index
# (RARV owns klaravex.note_submissions — different table).
# Apply: psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f 01-schema.sql
DATABASE_URL=postgresql://USER:CHANGE_ME@127.0.0.1:15432/klaravex?sslmode=require&options=-csearch_path%3Dvault

# Superuser password (used by the postgres container only, if running a
# local postgres sidecar; not needed when using the external Azure DB)
POSTGRES_PASSWORD=CHANGE_ME_postgres_superuser_password

# Service user password (used by the vault-mcp app container)
VAULT_SYNC_PASSWORD=CHANGE_ME_vault_sync_service_password

# --- Ollama (local embedding model — no API key needed) ---
# Internal Docker service name; change only if running Ollama outside Docker
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text

# --- MCP Server ---
VAULT_PORT=3141
LOG_LEVEL=info

# Optional: shared secret for authenticating tool calls.
# Set to a strong random string (e.g. openssl rand -hex 32).
# Leave blank to disable auth (only safe behind a VPN/firewall).
MCP_API_KEY=

# --- Embedding tuning (safe to leave as defaults) ---
# Must match the model's actual output dimension.
# nomic-embed-text = 768, mxbai-embed-large = 1024
EMBEDDING_DIMENSIONS=768

# --- Search defaults (overridable per call) ---
VECTOR_SEARCH_LIMIT=10
VECTOR_SIMILARITY_THRESHOLD=0.70

# --- Background worker poll interval (milliseconds) ---
WORKER_INTERVAL_MS=10000
