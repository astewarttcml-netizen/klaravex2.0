{
  "id": "kvxFreelancePipelineV1",
  "name": "[klaravex] freelance-pipeline",
  "nodes": [
    {
      "id": "freelance-scan-schedule",
      "name": "Schedule Scan (Every 2h weekdays 9-5 ET)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,11,13,15,17 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "freelance-bid-strategy-schedule",
      "name": "Schedule Bid Strategy (30min after scan)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        260
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9,11,13,15,17 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "freelance-bid-submit-schedule",
      "name": "Schedule Bid Submission (Every 30min weekdays 9-5 ET)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        420
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0,30 9-17 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "freelance-outcomes-schedule",
      "name": "Schedule Outcomes (Every 4h weekdays ET)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        580
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,13,17 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "freelance-http-request",
      "name": "Trigger freelance scan via API (P1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8002/api/v1/admin/agents/run-freelance-scan",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.KLARAVEX_ADMIN_API_KEY}}"
            }
          ]
        }
      }
    },
