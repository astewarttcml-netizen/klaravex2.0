      "name": "Schedule Drafts (Mon/Wed/Fri 09:00 ET)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 160],
      "parameters": {
        "rule": {
          "interval": [
