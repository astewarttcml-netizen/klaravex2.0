        "url": "http://api:8002/api/v1/admin/agents/run-daily-report",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.KLARAVEX_ADMIN_API_KEY}}"
