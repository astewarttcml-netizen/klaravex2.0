{
  "id": "kvxReportingV1",
  "name": "[klaravex] reporting",
  "nodes": [
    {
      "id": "report-daily-schedule",
      "name": "Schedule Daily Report (07:00 ET)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "report-weekly-schedule",
      "name": "Schedule Weekly Report (Mon 08:00 ET)",
