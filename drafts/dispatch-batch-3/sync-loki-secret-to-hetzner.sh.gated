#!/bin/bash
set -euo pipefail

# Constants
HETZNER_HOST="178.105.84.32"
ENV_FILE="/opt/loki/envs/.env.klaravex"
DOCKER_COMPOSE_FILE="/opt/loki/infra/docker-compose.klaravex.yml"
SERVICES=("klaravex_api" "klaravex_worker")

# Function to fetch LOKI_INTERNAL_SECRET from Azure
fetch_loki_secret() {
  local secret
  secret=$(az containerapp show --name klaravex --resource-group klaravex-rg --query configuration.secrets[?name=='LOKI_INTERNAL_SECRET'].value -o tsv)
  if [[ -z "$secret" ]]; then
    echo "Failed to fetch LOKI_INTERNAL_SECRET from Azure."
    exit 1
  fi
  echo "$secret"
}

# Function to update the env file on Hetzner
update_env_file() {
  local secret="$1"
  ssh "$HETZNER_HOST" <<EOF
    set -euo pipefail
    # Backup the existing env file
    cp "$ENV_FILE" "$ENV_FILE.bak"
    # Update the env file
    grep -v "^LOKI_INTERNAL_SECRET=" "$ENV_FILE.bak" > "$ENV_FILE.tmp"
    echo "LOKI_INTERNAL_SECRET=$secret" >> "$ENV_FILE.tmp"
    mv "$ENV_FILE.tmp" "$ENV_FILE"
    # Ensure the file is synced to disk
    sync "$ENV_FILE"
EOF
}

# Function to restart services sequentially
restart_services() {
  for service in "${SERVICES[@]}"; do
    ssh "$HETZNER_HOST" "docker compose -f $DOCKER_COMPOSE_FILE restart $service"
    sleep 5 # Wait for the service to start
    ssh "$HETZNER_HOST" "curl -f http://localhost:8001/healthz" || {
      echo "Health check failed for $service."
      return 1
    }
  done
}

# Function to verify the env var in each container
verify_env_var() {
  local secret="$1"
  for service in "${SERVICES[@]}"; do
    ssh "$HETZNER_HOST" "docker exec $service env | grep LOKI_INTERNAL_SECRET" | grep -q "$secret" || {
      echo "LOKI_INTERNAL_SECRET not found or incorrect in $service."
      return 1
    }
  done
}

# Function to rollback the env file
rollback_env_file() {
  ssh "$HETZNER_HOST" <<EOF
    set -euo pipefail
    if [[ -f "$ENV_FILE.bak" ]]; then
      mv "$ENV_FILE.bak" "$ENV_FILE"
      sync "$ENV_FILE"
    fi
EOF
}

# Main script execution
main() {
  local secret
  secret=$(fetch_loki_secret)
  update_env_file "$secret"
  if ! restart_services; then
    echo "Rolling back due to failure in restarting services."
    rollback_env_file
    exit 1
  fi
  if ! verify_env_var "$secret"; then
    echo "Rolling back due to failure in verifying env var."
    rollback_env_file
    exit 1
  fi
  echo "LOKI_INTERNAL_SECRET successfully synced and verified."
}

main
